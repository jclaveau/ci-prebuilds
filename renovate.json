{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ubuntu", "mirror.gcr.io/library/ubuntu"],
      "groupName": "Ubuntu base image",
      "description": "LTS only: even year + .04. Interim releases carry 9 months of support and Renovate reads them as newer, so it proposed 24.10 over the 24.04 LTS (PR #71). By the time that PR was looked at, oracular was EOL and all four of its repositories 404'd, so the bump would have broken every apt-get in ubuntu-gha-tools.",
      "allowedVersions": "/^\\d*[02468]\\.04$/"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["alpine", "mirror.gcr.io/library/alpine"],
      "groupName": "Alpine base image"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker"],
      "groupName": "Docker Engine"
    },
    {
      "matchDepNames": ["playwright", "@playwright/test"],
      "groupName": "Playwright"
    },
    {
      "matchDepNames": ["pnpm"],
      "groupName": "pnpm"
    },
    {
      "matchDatasources": ["node-version"],
      "matchPackageNames": ["node"],
      "groupName": "Node.js",
      "minimumReleaseAge": "3 days",
      "description": "node/Dockerfile.alpine copies node from our Stage B build (ghcr.io/jclaveau/node-musl, pinned by NODE_MUSL_IMAGE), so the PR also needs node-musl.yml dispatched on its branch and the new tag pinned: the alpine build fails naming the version until it is. The tarball fallback (NODE_BUILD=tarball, used by on-demand builds) waits on unofficial-builds, which publishes about a day after nodejs.org, and needs `scripts/pin-node-musl-sha.sh <version>` committed for its sha256."
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["nektos/act"],
      "groupName": "nektos/act"
    },
    {
      "matchPackageNames": ["ghcr.io/jclaveau/playwright-alpine-browsers"],
      "matchFileNames": ["playwright/Dockerfile.alpine"],
      "groupName": "Playwright",
      "automerge": true,
      "description": "The three consumer revs (CHS_REV / FF_REV / WK_REV) travel in the Playwright PR, not in PRs of their own. A rev tag only exists once promote ran, and promote now needs the perf gate green, so the group PR is automergeable exactly when every browser matching the new Playwright has been built, conformed and priced at parity. Apart, either half landed alone and left the consumer red: a new driver on old browsers (#234) or the reverse."
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^docker/Dockerfile$"],
      "matchStrings": [
        "ARG DOCKER_VERSION=(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^node/Dockerfile(\\.alpine)?$"],
      "matchStrings": [
        "ARG NODE_VERSION=(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "fileMatch": ["^playwright/Dockerfile(\\.alpine)?$"],
      "matchStrings": [
        "ARG PLAYWRIGHT_VERSION=(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "playwright",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "fileMatch": ["^playwright/alpine-browsers/versions\\.env$"],
      "matchStrings": [
        "PW_VERSION=(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "playwright",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "fileMatch": ["^pnpm/Dockerfile$", "^pnpm-gyp/Dockerfile$", "^pnpm-gyp/Dockerfile\\.alpine$"],
      "matchStrings": [
        "ARG PNPM_VERSION=(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "pnpm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/.*\\.ya?ml$"],
      "matchStrings": [
        "ACT_VERSION:\\s*(?<currentValue>[\\w.-]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "nektos/act",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "fileMatch": ["^alpine-gha-tools/Dockerfile$"],
      "matchStrings": [
        "ARG OS_VERSION=(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "mirror.gcr.io/library/alpine",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^ubuntu-gha-tools/Dockerfile$"],
      "matchStrings": [
        "ARG OS_VERSION=(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "mirror.gcr.io/library/ubuntu",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^playwright/alpine-browsers/Dockerfile\\.glibc-debug$"],
      "matchStrings": [
        "ARG UBUNTU_VERSION=(?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ubuntu",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^playwright/Dockerfile\\.alpine$"],
      "matchStrings": [
        "ARG CHS_REV=(?<currentValue>\\d+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/jclaveau/playwright-alpine-browsers",
      "extractVersionTemplate": "^chs-(?<version>\\d+)$",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "fileMatch": ["^playwright/Dockerfile\\.alpine$"],
      "matchStrings": [
        "ARG WK_REV=(?<currentValue>\\d+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/jclaveau/playwright-alpine-browsers",
      "extractVersionTemplate": "^wk-(?<version>\\d+)$",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "fileMatch": ["^playwright/Dockerfile\\.alpine$"],
      "matchStrings": [
        "ARG FF_REV=(?<currentValue>\\d+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/jclaveau/playwright-alpine-browsers",
      "extractVersionTemplate": "^ff-(?<version>\\d+)$",
      "versioningTemplate": "loose"
    }
  ],
  "schedule": [
    "before 6am every weekday"
  ],
  "timezone": "Europe/Paris",
  "automerge": true,
  "automergeStrategy": "squash",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 5
}
