# syntax=mirror.gcr.io/docker/dockerfile:1
ARG BASE_IMAGE=jclaveau/alpine-dood:latest
FROM ${BASE_IMAGE}

# Alpine's nodejs/npm (NodeSource is Debian-only). Node + npm only — no node-gyp toolchain (alpine-gha-tools
# no longer ships build-base). Native addon builds use the `-gyp` variant ({os}-{mode}-pnpm-gyp). See README.
LABEL org.opencontainers.image.description="Node + npm (slim, no compiler) in Alpine based DinD as Github Actions Container"

RUN echo "Install Node.js + npm from Alpine's repos" \
    && sudo apk add --no-cache nodejs npm

# A node in /usr/bin is invisible to `actions/setup-node`, which would then download the only build
# the manifest offers — glibc, unusable here. Symlinks only, so the image carries one node. The
# consumer must point RUNNER_TOOL_CACHE here, as a container job's default /__t is the host's own
# cache — see README.
COPY --chmod=755 register-node-in-tool-cache.sh /usr/local/bin/register-node-in-tool-cache
RUN register-node-in-tool-cache
