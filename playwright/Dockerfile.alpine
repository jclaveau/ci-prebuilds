# syntax=mirror.gcr.io/docker/dockerfile:1

# Global ARGs (visible in FROM lines below). BuildKit doesn't support ARG
# expansion in `COPY --from=` URLs, so we alias the producer-image refs as
# named build stages and COPY --from that name later.
ARG CHS_REV=1234
ARG FF_REV=1538
ARG WK_REV=2336
ARG BASE_IMAGE=jclaveau/alpine-dood-pnpm:latest

# WHICH producer tag each browser comes from. The default is the moving
# version-pinned tag the promote jobs write, so leaving these alone is exactly
# today's behaviour and Renovate keeps bumping the *_REV ARGs above.
#
# They exist so an EXPERIMENT ARM CAN BE MEASURED WITHOUT BEING MERGED. A perf
# arm publishes a sha-scoped artifact (`wk-sha-<sha>`, `ff-sha-<sha>`, …) that
# no moving tag points at, so until now the only way to get a consumer image
# carrying it was to merge the arm — which inverts the order: ship first,
# measure after. That cost the webkit ThinLTO arm a number despite building
# green with 21/21 conformance, and it had already been worked around once by
# editing a default on the branch, which is a change that then has to be
# remembered and undone.
#
# One arg per browser rather than one shared: an arm moves ONE browser and the
# other two must stay on the shipped tags, or the comparison measures two
# changes at once.
#
# Measuring an arm is not shipping it, and the gap is easy to miss because the
# arm's PR merges green. `promote-webkit` (and its firefox/chromium siblings)
# require `github.ref == 'refs/heads/main'`, so a branch dispatch publishes
# only `wk-sha-<sha>`; the following merge then runs a PUSH build, where the
# producer is dispatch-gated off and so builds nothing to promote. The fix
# never reaches the moving tag either way. That is how #180's launch fix sat
# unshipped while main carried its source: `wk-latest` still resolved to the
# build before it. Shipping such an arm is a deliberate retag of its sha
# artifact onto the moving tags with the same `docker buildx imagetools
# create` promote runs, and the consumer only picks it up on the NEXT push to
# main, since publishing here is gated on `push` too. Not any push: the
# `changes` job rebuilds this image only when `playwright/` (or a base layer)
# is in the diff, so a memory-only merge right after a retag rebuilds nothing.
# Chromium ships the same way through `promote-chromium-from-source.yml`,
# which retags `chs-<rev>` from a green branch chain; this comment is the
# `playwright/` touch that rebuilt the consumer after the unbundle retag,
# and again after the snapshot-clang retag (#273, chs-1234 → ccc8534).
ARG CHS_SOURCE_TAG=chs-${CHS_REV}
ARG FF_SOURCE_TAG=ff-${FF_REV}
ARG WK_SOURCE_TAG=wk-${WK_REV}

# Producer-image stage aliases — Renovate's custom manager bumps the tag
# revision in lockstep with PLAYWRIGHT_VERSION below.
FROM ghcr.io/jclaveau/playwright-alpine-browsers:${CHS_SOURCE_TAG} AS chs-source
FROM ghcr.io/jclaveau/playwright-alpine-browsers:${FF_SOURCE_TAG} AS ff-source
FROM ghcr.io/jclaveau/playwright-alpine-browsers:${WK_SOURCE_TAG} AS wk-source

# libm-fmod-custom.so — a drop-in `fmod` for musl, preloaded under WebKit alongside
# mimalloc. musl's fmod walks the exponent difference one bit per iteration
# with a data-dependent branch, so for large dividends every call eats ~21
# unpredictable branches: 163.8 ms per 3M calls against glibc's 54.0. That is
# the whole of `libm_fmod`, our largest per-metric gap on any browser (5.35x on
# an EPYC 7763, 7.65x on a Xeon 8370C) — both engines call libc the same
# 3,000,000 times per kernel, so it was never JSC. See issue #126.
#
# The same .so carries libm-fmodf-custom.c's fmodf, preloaded under chromium:
# chrome-headless-shell imports fmodf (and no fmod) from musl, from 66 call
# sites in canvas arcs, Skia dashing, colour conversion and CSS calc.
#
# libm-fmod-custom.c is also linked into Firefox's libxul (alpine-browsers/Dockerfile).
# It replaces the shipped bit-loop (now candidates/fastfmod.c), which read
# 0.92-0.94 against official on an EPYC 7763 but 1.16 on an EPYC 9V74; its
# kernel bench reads 0.81x (7763), 0.84x (9V74), 0.86x (9V45) against glibc.
#
# Compiled here and gated in .github/workflows/libm-fmod-custom-gate.yml, which runs
# the same operand stream with and without it and compares raw result bits.
# The smoke below is only a build-time sanity check that the object loads and
# answers; bit-exactness is the workflow's job, over 7.5M comparisons.
FROM ${BASE_IMAGE} AS libm-fmod-custom-build
COPY alpine-browsers/libm-fmod-custom /work/libm-fmod-custom
RUN sudo apk add --no-cache gcc musl-dev \
 && sudo gcc -O2 -fPIC -Wa,-mbranches-within-32B-boundaries -c -o /tmp/libm-fmodf-custom.o \
      /work/libm-fmod-custom/libm-fmodf-custom.c \
 && sudo gcc -O2 -fPIC -shared -o /usr/lib/libm-fmod-custom.so /work/libm-fmod-custom/libm-fmod-custom.c \
      /tmp/libm-fmodf-custom.o \
 && printf '%s\n' \
      '#include <stdio.h>' \
      '#include <math.h>' \
      'int main(void){' \
      '  /* k*y + r with k=1e6, y=2^32, r=12345: a ~32-bit exponent gap, and' \
      '     exactly representable since doubles have unit spacing below 2^52. */' \
      '  if (fmod(1000000.0 * 4294967296.0 + 12345.0, 4294967296.0) != 12345.0) return 1;' \
      '  if (fmod(7.5, 2.0) != 1.5) return 2;' \
      '  if (fmod(-7.5, 2.0) != -1.5) return 3;' \
      '  if (!isnan(fmod(1.0, 0.0))) return 4;' \
      '  if (fmod(3.0, INFINITY) != 3.0) return 5;' \
      '  if (fmodf(7.5f, 2.0f) != 1.5f) return 6;' \
      '  if (fmodf(-370.0f, 360.0f) != -10.0f) return 7;' \
      '  if (fmodf(16777215.0f, 3.0f) != 0.0f) return 8;' \
      '  puts("libm-fmod-custom smoke ok"); return 0; }' \
    > /tmp/smoke.c \
 && gcc -O2 -fno-builtin-fmod -fno-builtin-fmodf -o /tmp/smoke /tmp/smoke.c -lm \
 && LD_PRELOAD=/usr/lib/libm-fmod-custom.so /tmp/smoke

# libfaststring.so — AVX2 memcpy/memmove/memset/memcmp/strlen for chromium.
# Alpine has no IFUNC, so musl links ONE implementation of each where glibc
# dispatches an AVX2/ERMS variant off the CPU at load, and `nm -D` shows
# official chromium resolving all five internally while ours calls out to musl.
# Preloading these takes layout_boxonly 1.29x -> 1.25x and layout_text
# 1.20x -> 1.16x against the official image, same build, same fonts, same
# machine (run 34339130160).
#
# Every AVX2 kernel is behind __attribute__((target("avx2"))) and a
# __builtin_cpu_supports check made at load; the file is compiled WITHOUT
# -mavx2 so nothing outside those kernels can emit an AVX2 instruction, and a
# host without AVX2 forwards to musl's own routines for one indirect call.
# CHS_FAST_STRING=0 forces that path at runtime.
#
# run-gate.sh is the correctness gate — musl as the reference, a deliberately
# corrupted build that must fail, a load witness, and both paths exercised. It
# runs here so a shim that miscopies cannot reach a published image, and again
# in CI over the shipped .so.
FROM ${BASE_IMAGE} AS faststring-build
COPY alpine-browsers/chromium-headless-shell/faststring /work/faststring
RUN sudo apk add --no-cache gcc musl-dev binutils \
 && sudo sh /work/faststring/run-gate.sh /work/faststring /tmp/faststring-gate \
 && sudo cp /tmp/faststring-gate/libfaststring.so /usr/lib/libfaststring.so

# libz-ng-compat.so.1 — zlib-ng built in zlib-compat mode, preloaded under
# WebKit. `page.screenshot({type:'png'})` costs us 49.15 ms/shot against
# official's 46.38, and a perf record of the WebProcess (run 34207799987) puts
# 81% of the shot in libz + libpng and the whole +2.77 ms delta there too:
# libpng16 17.374 vs 15.484 ms/shot, libz 23.826 vs 22.446. Capture and
# readback carry no measurable time at all — no Skia, GL, EGL, gallium, cairo
# or GStreamer DSO appears — and both sides rasterize byte-identical pixels, so
# this is codec CPU alone.
#
# The cause is Alpine's `-Os`: abuild.conf exports it and libpng's APKBUILD does
# not override it (zlib's does, to -O2). Our libpng aligns 14 of 276 functions
# to 16 bytes, Ubuntu's aligns 246 of 246. Rebuilt -O2 from the same source, the
# filter kernel goes 61.8 -> 50.2 ms against official's 49.7. Ubuntu is NOT
# running zlib-ng (zero zng_/crc32_fold/chunkcopy markers) and neither libpng
# carries SSE2 filter kernels, so this is not a SIMD-dispatch gap.
#
# zlib-ng is the larger and cheaper win: preloaded into an otherwise unmodified
# image it takes full PNG encode from 1.10x official to 0.73x (crc32 11x,
# adler32 9.6x, deflate 2.35x).
#
# The build, the ZLIB_COMPAT rationale and the smoke live in the script, which
# the conformance runner runs too so that conformance exercises the browser we
# ship (playwright/alpine-browsers/conformance/build-runner.sh).
#
# zlib-ng emits DIFFERENT bytes from zlib (2% smaller at L6, valid PNG). PW's
# own suite is byte-insensitive here — `getComparator('image/png')` decodes
# with PNG.sync.read and compares pixels (packages/utils/comparators.ts), the
# only byteLength assertions are on jpeg/webp, and every screenshot .equals()
# compares two shots from the same encoder in the same run.
FROM ${BASE_IMAGE} AS zlibng-build
COPY alpine-browsers/webkit/zlib-ng /work/zlib-ng
RUN sudo sh /work/zlib-ng/build-zlib-ng.sh

# Runtime libs. chromium-headless-shell has RPATH=$ORIGIN but the FROM-SOURCE
# build (unlike the old apk one) is NOT fully self-contained — it dynamically
# links Alpine's libxslt + double-conversion + minizip + crc32c (aports chromium
# builds these use_system_*), so the consumer must supply them or the binary
# dies at load with `Error relocating … symbol not found`. Firefox bundles its
# peer .so + ICU data but still needs the universal runtime libs (libstdc++,
# libgcc_s, musl). WebKit-WPE loads libwpe + GTK4 + a full gstreamer stack.
# Apk list union of aports' community/chromium + community/firefox `depends=`
# plus the WebKit deps proven by the producer Tier-2 smoke, trimmed to what
# headless actually loads.
#
# Own stage because BOTH the final image and the strip stage below need this
# exact apk set — the strip scripts' ldd gate resolves the bundles' remaining
# ELFs against it, so a divergence between the two would let the strip stage
# validate a layout the final image can't load.
FROM ${BASE_IMAGE} AS runtime-libs
RUN sudo apk add --no-cache \
        ca-certificates font-opensans ttf-freefont \
        alsa-lib dbus-libs fontconfig glib gtk+3.0 harfbuzz \
        libdrm libevent libffi libjpeg-turbo libnotify libogg libtheora \
        libvorbis libvpx libwebp libwebpdemux libxcomposite libxt mesa-gl \
        nspr nss pipewire-libs libpulse libstdc++ libgcc mimalloc2-insecure \
        libwpe libwpebackend-fdo gtk4.0 at-spi2-core cairo pango gdk-pixbuf \
        mesa-gles mesa-gbm mesa-dri-gallium mesa-vulkan-swrast \
        gstreamer gst-plugins-base gst-plugins-good gst-plugins-bad gst-libav \
        opus libsecret \
        libxslt double-conversion minizip crc32c

# gtk4.0 pulls tzdata in, and 600 zone files with no /etc/localtime cost every
# process that initialises ICU (node, the shim, browser, zygote, utility):
# - ICU's uprv_tzname() reads $TZ, then readlinks /etc/localtime
# - both missing, it walks /usr/share/zoneinfo comparing each file's bytes to
#   /etc/localtime — 1,245 failed opens per process, 9,300 per chromium launch
# - the official image symlinks /etc/localtime at UTC, so readlink answers
RUN sudo ln -sf /usr/share/zoneinfo/UTC /etc/localtime

# GStreamer's frei0r plugin registers 0 features here (no frei0r effects are
# installed), but it declares a dependency on $HOME/.frei0r-1/lib. That makes
# any registry baked under one HOME stale for every other user, so WebKit
# rescans on each launch (~20 ms) instead of reading the baked registry below.
RUN sudo rm /usr/lib/gstreamer-1.0/libgstfrei0r.so

# Firefox + WebKit staging: the bundles are COPY'd in, shimmed and stripped
# HERE, and the final image COPYs the finished trees out.
#
# The strip MUST happen before the final image's COPY. Layer blobs are
# immutable: `rm`-ing a bundled lib in a RUN layer that follows the COPY only
# writes a whiteout into that later layer — the bytes stay paid for in the COPY
# blob, so the published (and benchmarked) image size doesn't move at all. With
# the strip in its own stage, the final image's COPY layers carry only the
# post-strip bytes and the strip RUN layers never reach it.
#
# Both bundles share one stage because the cross-bundle ICU dedup symlinks
# webkit's libicu* at firefox's copies — they have to be stripped side by side,
# at the paths they'll occupy in the final image (the symlinks are relative).
FROM runtime-libs AS browsers-staged

ARG FF_REV
ARG WK_REV

# chromium is staged here too so the LD_PRELOAD wrapper rename below lands
# in the same layer as the binary. Renaming in the final stage copied the
# 195 MB binary up into a second layer — 81 MiB gz on top of the 94 MiB COPY
# layer, whose copy then sat under a whiteout: 10% of the published image
# (791 -> 710 MiB gz) was a file consumers download and never see, and the
# cold pull read 22.9 -> 18.1 s on one box. Same rule as the strip pass:
# mutate before the final COPY, never after.
ARG CHS_REV

# chromium-headless-shell — apk-extracted, self-contained via RPATH=$ORIGIN.
# Smaller artifact than full chromium; deterministic timing for tests. Copied
# straight from the producer, no strip pass: it bundles no apk-provided libs.
COPY --from=chs-source /chrome-headless-shell-linux64 /ms-playwright/chromium_headless_shell-${CHS_REV}/chrome-headless-shell-linux64
RUN sudo touch /ms-playwright/chromium_headless_shell-${CHS_REV}/INSTALLATION_COMPLETE \
 && sudo chmod 755 /ms-playwright/chromium_headless_shell-${CHS_REV} \
 # Drift warning: the producer bakes /chrome-headless-shell-linux64/.version-drift-warning
 # when alpine:edge's chromium pkgver doesn't match PW's pinned browserVersion.
 # PW SDK doesn't validate version at launch (path-name match is enough), but
 # tests on version-sensitive APIs may behave differently. Echo the file at
 # image build time so the drift is visible in build logs; image still ships.
 && WARN=/ms-playwright/chromium_headless_shell-${CHS_REV}/chrome-headless-shell-linux64/.version-drift-warning \
 && if [ -f "$WARN" ]; then \
      echo "===== chromium-headless-shell version drift warning =====" >&2; \
      cat "$WARN" >&2; \
      echo "==========================================================" >&2; \
    fi

# chromium has no launch shim of its own — playwright execs the binary
# directly — so the final stage's container-wide LD_PRELOAD would reach it and silently
# put mimalloc under PartitionAlloc. Every earlier decision in this file
# deliberately left chromium's allocator alone, so the shim CLEARS that preload
# rather than adding to it. CHS_LD_PRELOAD names what chromium preloads instead
# (libfaststring.so and libm-fmod-custom.so by default); local-counted-compare.sh
# and perf-gate set it to price a preload, and an empty value means none.
#
# libfaststring.so is loaded by default since the faststring tail fix
# (c7a2508). Seven perf-gate draws of the same chs-latest with vs without it
# (37524874478, 37527624043..37527644796; EPYC 7763 x3, 9V74 x3, 9V45 x1):
#
#   layout   0.954-0.999 in 7/7, mean ~0.984
#   launch   0.961-1.022, mean ~0.99 (the extra DSO no longer shows)
#   geomean  0.985-1.010, mean ~0.997
#
# Before the fix it was left unloaded: kernels finished with a byte loop under
# 32 bytes, layout_text was flat once bracketed, and launch read 1.43x with it
# against 1.36x without (runs 34355411280, 34357346361), back when the DSO
# closure still bound launch. The conformance runner (build-runner.sh) mirrors
# this launcher and preload.
#
# The shim also points the Vulkan loader at chromium's own SwiftShader ICD.
# mesa-vulkan-swrast (installed above for the shared Mesa closure) registers
# lavapipe in /usr/share/vulkan/icd.d, which official's image has none of, so
# every GPU process dlopened libvulkan_lvp.so + libLLVM.so.22 beside the
# SwiftShader it then picks anyway. famille i3-4005U, chromium 151.0.7922.34:
#
#   ANGLE initializationTime  118-145 ms vs 38-59 ms (official 34 ms)
#   launch→newPage→close      247.8 vs 240.5 ms median, p90 270.2 vs 254.6 ms
#                             (80 rounds interleaved in one container)
#
# A caller's own VK_ICD_FILENAMES still wins.
RUN CHS=/ms-playwright/chromium_headless_shell-${CHS_REV}/chrome-headless-shell-linux64 \
 && sudo mv "$CHS/chrome-headless-shell" "$CHS/chrome-headless-shell.real" \
 && printf '%s\n' \
        '#!/bin/sh' \
        'DIR="${0%/*}"' \
        'if [ -n "${CHS_LD_PRELOAD:-}" ]; then export LD_PRELOAD="$CHS_LD_PRELOAD"; else unset LD_PRELOAD; fi' \
        'export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-$DIR/vk_swiftshader_icd.json}"' \
        'exec "$DIR/chrome-headless-shell.real" "$@"' \
  | sudo tee "$CHS/chrome-headless-shell" >/dev/null \
 && sudo chmod +x "$CHS/chrome-headless-shell"

# Firefox — musl-built, PW-patched. The producer artifact ships the dist tree
# at /firefox; stage it at PW SDK's auto-discovery path
# /ms-playwright/firefox-${FF_REV}/firefox.
COPY --from=ff-source /firefox /ms-playwright/firefox-${FF_REV}/firefox
RUN sudo touch /ms-playwright/firefox-${FF_REV}/INSTALLATION_COMPLETE \
 && sudo chmod 755 /ms-playwright/firefox-${FF_REV}

# Firefox launch shim — handles three musl-FF quirks:
#
# 1. ICU data file. aports builds firefox --with-system-icu; Alpine's
#    libicudata.so.${maj} is a 12 KB stub and the real data file lives at
#    /usr/share/icu/${ver}/icudt${maj}l.dat. The producer bakes that file
#    into the artifact (see bundle-dist.sh); the shim points ICU_DATA at
#    the artifact dir so libicuuc resolves it relatively. ICU_DATA can't
#    be ENV-set image-wide — it'd leak into Node.js (built against a
#    different ICU major) and break its ICU module with "RangeError:
#    Internal error. Icu error." on first localeCompare call.
#
# 2. Juggler-activation. On the musl FF build (and also on glibc with the
#    same patches — not musl-specific), PW's `m-remote` command-line-handler
#    is shadowed by Mozilla's RemoteAgent in static_components dedup.
#    `-juggler-pipe` alone is silent. Activating Mozilla's RemoteAgent via
#    `--remote-debugging-port=0` side-effects Juggler into life. The producer
#    Tier-2 smoke does this from test code; the shim makes PW-driven launches
#    get the flag transparently. Drop the flag once a build-side Juggler
#    self-bootstrap fix lands in the producer.
#
# 3. The allocator. Playwright's own firefox links mozjemalloc — `nm -D` on
#    its libxul leaves `malloc` undefined 0 times, ours 1. We cannot build
#    mozjemalloc on musl: mozmemory_wrap.h declares free_impl/memalign_impl
#    `noexcept(true)` to match glibc's __THROW, musl does not mark them, and
#    every decl mismatches its previous one. So musl's malloc answered every
#    allocation, and that — not the PNG encoder, not musl's string routines,
#    not the missing PGO — was the whole gap against official: preloading
#    mimalloc moves screenshot 0.69x -> 0.96x, launch 0.83x -> 1.02x and
#    eval_rtt 0.86x -> 1.00x, while int_math and locator_click, which
#    allocate nothing, stay identical (runs 32833439914, 32833725968).
#    Scoped to the shim rather than ENV so it reaches firefox and its
#    children and not the Node.js driving them, and so chromium's
#    PartitionAlloc is left alone. WebKit gets the same preload from its
#    own pw_run.sh wrapper below — bmalloc covers only fastMalloc there.
RUN sudo mv /ms-playwright/firefox-${FF_REV}/firefox/firefox \
            /ms-playwright/firefox-${FF_REV}/firefox/firefox.real \
 && printf '%s\n' \
        '#!/bin/sh' \
        'DIR="${0%/*}"' \
        'export LD_PRELOAD=/usr/lib/libmimalloc-insecure.so.2' \
        'ICU_DATA="$DIR" exec "$DIR/firefox.real" --remote-debugging-port=0 "$@"' \
  | sudo tee /ms-playwright/firefox-${FF_REV}/firefox/firefox >/dev/null \
 && sudo chmod +x /ms-playwright/firefox-${FF_REV}/firefox/firefox

# WebKit — musl-built WPE MiniBrowser, from source. The producer ships the
# PW-layout dist tree at /webkit (pw_run.sh + minibrowser-{wpe,gtk}/ + peer .so);
# stage it at PW SDK's auto-discovery path /ms-playwright/webkit-${WK_REV}/. PW's
# webkit driver execs pw_run.sh directly — no launch shim needed (unlike Firefox).
#
# We COPY ONLY minibrowser-wpe (+ pw_run.sh), NOT minibrowser-gtk. pw_run.sh
# picks the port by flag: `--headless` → minibrowser-wpe, else minibrowser-gtk.
# PW always launches headless here, so gtk (~167 MB compressed, ~400 MB on disk)
# is never execed — headed WebKit is unsupported on musl (libgtk-4 self-recursion
# crash; producer Tier-2 headed is `if: false`). Dropping it is pure dead-weight
# removal; the producer artifact still ships both for when headed lands. See
# project_webkit_gtk_headed_recursion.
COPY --from=wk-source /webkit/minibrowser-wpe /ms-playwright/webkit-${WK_REV}/minibrowser-wpe
COPY --from=wk-source /webkit/pw_run.sh /ms-playwright/webkit-${WK_REV}/pw_run.sh
RUN sudo touch /ms-playwright/webkit-${WK_REV}/INSTALLATION_COMPLETE \
 && sudo chmod 755 /ms-playwright/webkit-${WK_REV}

# The allocator, same lever as firefox's above. bmalloc/libpas is compiled in
# (`USE_SYSTEM_MALLOC_DEFAULT OFF` for x86_64, no libc condition) but it backs
# `WTF::fastMalloc` only — WebCore and JSC. Every other allocation in the
# process goes to musl's mallocng: GLib/GObject, GStreamer, Skia, Cairo,
# HarfBuzz, ICU, libsoup, fontconfig, freetype. That is the startup and
# page-setup half of the process, and it is exactly the half measured slow
# (goto_cold 1.52x, launch 1.37x, click_force 1.30x, context_page 1.26x
# against official, while layout 0.95x and int_math 0.97x — engine code, the
# part bmalloc already covers — is faster). `malloc` reads undefined in BOTH
# libWPEWebKit and official's, so firefox's `nm -D` discriminator says nothing
# here; the tell is which allocator answers the NON-fastMalloc calls.
#
# Wrapping pw_run.sh rather than exporting ENV keeps the preload off the Node
# driver and off chromium, and rather than editing pw_run.sh's text so that a
# PW-side rewrite of that script cannot silently drop it. pw_run.sh resolves
# everything from `$(dirname "$0")`, so it is indifferent to being renamed
# inside its own directory.
#
# The wrapper also turns Skia's GPU painting OFF. On this image "GPU" means
# llvmpipe, Mesa's software rasteriser, and the click profile shows llvmpipe
# burning 1.89x the CPU per iteration that Playwright's does — with a
# SkiaGPUWorker thread on our side that theirs does not have at all. Painting
# on the CPU instead skips the round trip through a GL context that is itself
# the CPU. Measured twice, n=10, on one runner each time: goto_cold 1.07 ->
# 0.89 and 1.13 -> 0.92, goto_warm 1.01 -> 0.90 and 1.01 -> 0.91, context_page
# 0.97 -> 0.91 and 0.94 -> 0.89, everything else flat. pw-conformance.yml
# passes the same variable so the browser conformance tests is the browser we
# ship.
#
# The same wrapper carries libm-fmod-custom.so and libz-ng-compat.so.1 (built in the
# libm-fmod-custom-build and zlibng-build stages above). All three are plain
# interpositions of disjoint symbols, so the order between them does not
# matter. If any object fails to load, ld.so warns on stderr and continues:
# WebKit still runs and still returns correct results, just at musl's
# allocator, musl's fmod and Alpine's -Os zlib speed. There is no correctness
# dependency on any preload succeeding.
#
# WK_ZLIB_NG=0 drops only the zlib-ng entry. It exists so the runtime perf
# probe can put both arms on ONE runner: the ratio is CPU-model dependent, and
# two runs on two runners cannot be differenced.
#
# LP_NUM_THREADS=0 makes llvmpipe rasterise on the thread that submits the
# draw instead of handing tiles to its worker pool. Counted on an i3-4005U
# (2c/4t), click_force: 4609 vs 3108 CPU-ms/iter, 4.92 vs 3.39 G instructions,
# median 1754 vs 1147 ms; official is 4058 CPU-ms there. WK_LP_NUM_THREADS
# empty leaves llvmpipe's default (one thread per core), so perf-gate can
# price it in one run via candidate_build_args.
#
# MIMALLOC_PURGE_DELAY=-1 stops mimalloc returning freed pages to the kernel.
# A steady-state click loop profiled against Playwright's official image
# (browser-perf-record 35615190100, 35625723200) paid ~5x the page faults and
# 2.7-3.3x the madvise calls at parity on total CPU; the purge is what
# generates that churn. perf-gate A/B, n=10, whole container across every
# row: page faults 0.935 / 0.937 (EPYC 7763) and 0.950 (9V45), sys time
# 0.972 / 0.966 on the 7763, flat on the 9V45, peak memory and wall flat
# (runs 38044341427, 38044342985, 38044344421). WK_MIMALLOC_PURGE_DELAY
# empty restores mimalloc's default, so perf-gate can price it via
# candidate_build_args.
ARG WK_LP_NUM_THREADS=0
ARG WK_MIMALLOC_PURGE_DELAY=-1
RUN sudo mv /ms-playwright/webkit-${WK_REV}/pw_run.sh \
            /ms-playwright/webkit-${WK_REV}/pw_run.real.sh \
 && printf '%s\n' \
        '#!/bin/sh' \
        'DIR="${0%/*}"' \
        'ZNG=""' \
        '[ "${WK_ZLIB_NG:-1}" = 1 ] && ZNG=":/usr/lib/libz-ng-compat.so.1"' \
        'export LD_PRELOAD=/usr/lib/libmimalloc-insecure.so.2:/usr/lib/libm-fmod-custom.so$ZNG' \
        'export WEBKIT_SKIA_ENABLE_CPU_RENDERING=1' \
        'REG="${XDG_CACHE_HOME:-$HOME/.cache}/gstreamer-1.0/registry.x86_64.bin"' \
        '[ -n "$GST_REGISTRY$GST_REGISTRY_1_0" ] || [ -e "$REG" ] || { mkdir -p "${REG%/*}" && cp "$DIR/gst-registry.bin" "$REG"; } 2>/dev/null' \
        "${WK_LP_NUM_THREADS:+export LP_NUM_THREADS=${WK_LP_NUM_THREADS}}" \
        "${WK_MIMALLOC_PURGE_DELAY:+export MIMALLOC_PURGE_DELAY=${WK_MIMALLOC_PURGE_DELAY}}" \
        'exec "$DIR/pw_run.real.sh" "$@"' \
  | sudo tee /ms-playwright/webkit-${WK_REV}/pw_run.sh >/dev/null \
 && sudo chmod +x /ms-playwright/webkit-${WK_REV}/pw_run.sh

# WebKit's bundle carries Mesa's software-GL closure (libgallium → libLLVM +
# EGL/GL/gbm/drm/X11/xcb, ~225 MB on-disk) copied in by the producer's
# bundle-dist.sh ldd-walk. The apk Mesa above (mesa-gl/-gles/-gbm/
# -dri-gallium/-vulkan-swrast) already provides that closure at /usr/lib, so
# the bundle copy is pure duplication — the bundle's RPATH=$ORIGIN falls back
# to /usr/lib for anything it no longer carries. Strip it (consumer-side dedup,
# script shipped in the artifact); its ldd gate fails the build if any remaining
# ELF can't resolve against the apk Mesa.
COPY --from=wk-source /webkit/scripts/strip-mesa-closure.sh /usr/local/bin/strip-mesa-closure.sh
RUN sudo bash /usr/local/bin/strip-mesa-closure.sh /ms-playwright/webkit-${WK_REV}/minibrowser-wpe

# Same dedup for the universal runtime libs (glib/gtk3/cairo for Firefox,
# glib/soup/gstreamer/sqlite for WebKit, ~60 MB) — every entry is in the apk
# set above, RPATH=$ORIGIN falls back to /usr/lib, and the recursive ldd gate
# fails the build on any lib the apk doesn't provide. Only the browser's own
# libs + ICU/flite/avif/hyphen/woff2 stay bundled (exclusion policy in the
# script header). The conformance runner applies the SAME strip
# (build-runner.sh), so the tested layout == the shipped layout; libvpx is
# the lone apk-strip exception (stays bundled — the edge apk libvpx lacks
# mozilla's symbol set, so the edge-based runner can't validate a vpx-stripped
# layout, see the script header). ICU too stays bundled (the 3.24 apk ships
# only the en-only icu-data-en set), but since both bundles carry byte-identical
# ICU 78, webkit's copy is symlinked to firefox's here — one copy instead of
# two. The per-browser runners keep real ICU copies (each runs a single bundle);
# the loader resolves the same bytes either way, so the parity holds.
#
# COPY'd from the build context (./playwright), not wk-source: the script must
# not depend on the wk producer artifact carrying it — wk-<rev> only rebuilds
# on dispatch/PR-label, so a fresh script would fail the COPY until a ~6h
# producer run. The strip runs against THIS image's apk base, so the repo
# HEAD's copy is the right content.
COPY alpine-browsers/webkit/scripts/strip-bundled-libs.sh /usr/local/bin/strip-bundled-libs.sh
RUN sudo bash /usr/local/bin/strip-bundled-libs.sh /ms-playwright/firefox-${FF_REV}/firefox firefox \
 && sudo bash /usr/local/bin/strip-bundled-libs.sh /ms-playwright/webkit-${WK_REV}/minibrowser-wpe webkit /ms-playwright/firefox-${FF_REV}/firefox

# The first WebKit launch in a fresh container scans every GStreamer plugin
# into ~/.cache/gstreamer-1.0 before the page opens. On an i3-4005U, that first
# launch takes 763 ms vs 130 ms for later ones (official: 1358 vs 148 ms).
# Baking the registry here takes it to 161 ms. The shim copies it to the
# user's default registry path on first launch rather than pointing
# GST_REGISTRY at it: this file is read-only, so a registry gst finds stale
# could never be rewritten, and gst rescanned on every launch. The one built
# here does go stale in the final image (gio's entry, cause not pinned down),
# and pointing at it cost every warm launch 145.7 vs 123.5 ms. A writable copy
# is rescanned once (first launch 216 ms) and is fresh from then on.
RUN sudo apk add --no-cache --virtual .gst-tools gstreamer-tools \
 && sudo env GST_REGISTRY=/ms-playwright/webkit-${WK_REV}/gst-registry.bin gst-inspect-1.0 >/dev/null \
 && sudo chmod 644 /ms-playwright/webkit-${WK_REV}/gst-registry.bin \
 && sudo apk del --no-cache .gst-tools

FROM runtime-libs

# Re-declare so ${CHS_REV} / ${FF_REV} / ${WK_REV} expand in this stage's paths.
ARG CHS_REV
ARG FF_REV
ARG WK_REV

# Renovate will update this in lockstep with the producer image's published
# tag. Same PW_VERSION drives `pnpm install -g playwright@…` AND the
# COPY --from tag above — they must match (PW SDK reads its bundled
# browsers.json to know the expected revision in the cache path).
ARG PLAYWRIGHT_VERSION=1.62.1

LABEL org.opencontainers.image.description="Playwright (musl-native chromium-headless-shell + Firefox + WebKit) in Alpine based DinD as Github Actions Container"

# Playwright's bundled browsers are glibc-only and `playwright install
# --with-deps` runs apt — neither works on Alpine/musl. We stage both
# musl-native browsers from our producer image at PW SDK's auto-discovery
# cache path; the SDK finds them via PLAYWRIGHT_BROWSERS_PATH lookup at
# launch time. No executablePath override required in playwright.config.ts.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
# Suppresses PW's "musl not supported" warning — its hostPlatform.ts detects
# `linux-musl` but its DOWNLOAD_PATHS table has no entry. Safe because we
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 anyway; no download is attempted.
ENV PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24
# PW's pre-launch host-requirements check reads the ubuntu24 nativeDeps list
# (because of the override above) and false-positives on musl for WebKit — it
# reports libGLESv2.so.2 + libx264.so "missing" although the MiniBrowser
# binaries are ldd-clean (verified) and chromium/firefox launch fine. Skip the
# bogus validation; a genuinely-missing dep would still fail at spawn time.
ENV PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1
# WebKit's bwrap sandbox can't nest inside a container's default seccomp/user-ns
# profile on musl. Disable it so headless WPE launches; the consumer must ALSO
# run the container with `--security-opt seccomp=unconfined` (documented in the
# image README) — the two are required together (see the producer Tier-2 smoke).
ENV WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1

# The Playwright DRIVER's allocator. Every browser shim already preloads
# mimalloc for the browser itself; this is the node process on the other end of
# the pipe, which still used musl malloc.
#
# `eval_rtt` is 500 sequential page.evaluate round trips — the driver's
# stream/pipe and event-loop path, re-paid by every Playwright action — and it
# is the row that did not move when the browsers got mimalloc. Preloading it
# into node is worth +7.8% and +13.2% on that row across two ff-perf-ab runs on
# different CPUs with the arms in opposite order (33065282215, 33065574061),
# while the browser-only controls stay flat: click_force 1.000/0.999,
# locator_click 1.000/1.000.
#
# This is an OURS-VS-OURS improvement only. It does NOT beat the official
# image on eval_rtt: two draws against it read 0.957 and 1.022, and the n=10
# baseline classes that row as tied. Do not quote it as a win over official.
#
# The insecure build, as in the browser shims. A CI A/B once read the two
# within ~2% on the driver (33066499518), but a counted local run put secure
# at 318 ms vs 297 ms on eval_rtt (0.93x, 713 vs 694 M instructions per
# iteration): the secure build's guard pages and encoded free lists cost the
# driver real time. Official's node runs plain glibc malloc, which has neither,
# so this does not drop below official's hardening. Security trade-off parked
# for later, not dismissed.
#
# Scope: this is a container-wide ENV, so it reaches every process a user runs
# here, not just the driver.
ENV LD_PRELOAD=/usr/lib/libmimalloc-insecure.so.2

# The fmod/fmodf interposer the webkit and chromium launchers preload. ~10 kB;
# reaches MiniBrowser, chrome-headless-shell and their auxiliary processes,
# and nothing else — not the Node driver, not firefox.
COPY --from=libm-fmod-custom-build /usr/lib/libm-fmod-custom.so /usr/lib/libm-fmod-custom.so

# zlib-ng in zlib-compat mode, preloaded by the same webkit launcher. Reaches
# MiniBrowser and its auxiliary processes only — chromium and firefox bundle
# their own zlib and are untouched.
COPY --from=zlibng-build /usr/lib/libz-ng-compat.so.1 /usr/lib/libz-ng-compat.so.1

# The string interposer the chromium launcher preloads. Reaches
# chrome-headless-shell and its renderers and nothing else — firefox and
# webkit set their own LD_PRELOAD, and the Node driver keeps the
# container-wide one.
COPY --from=faststring-build /usr/lib/libfaststring.so /usr/lib/libfaststring.so

# What the chromium launcher preloads. perf-gate's candidate_build_args sets it
# (CHS_LD_PRELOAD= for none) to price a chromium-only preload against an
# otherwise identical control. libm-fmod-custom.so answers chrome's fmodf: at
# gaps 3-8 the integer candidate it grew from took 3.4-4.7 ns per call vs
# musl's 19.5-51.1 ns on the CI CPUs (run 37929140939), bit-identical over the
# gate's 4M fmodf comparisons.
ARG CHS_LD_PRELOAD=/usr/lib/libfaststring.so:/usr/lib/libm-fmod-custom.so
ENV CHS_LD_PRELOAD=${CHS_LD_PRELOAD}

# Opt-in Node driver swap, off by default: perf-gate's candidate_build_args sets
# both to price nodejs.org's own musl build of the same Node against Alpine's.
# Alpine's nodejs links openssl, ICU, brotli and c-ares from the system and is
# LTO-built; the tarball bundles them, as the static node in official's image
# does. A local counted run (insn mix 2026-10-06) put Alpine's node at +3%
# driver instructions on eval_rtt and +5% on locator_click, JIT code 2x.
ARG NODE_MUSL_TARBALL_VERSION=
ARG NODE_MUSL_TARBALL_SHA256=
RUN if [ -n "${NODE_MUSL_TARBALL_VERSION}" ]; then \
      set -e; \
      tarball="node-v${NODE_MUSL_TARBALL_VERSION}-linux-x64-musl.tar.xz"; \
      wget -qO "/tmp/${tarball}" "https://unofficial-builds.nodejs.org/download/release/v${NODE_MUSL_TARBALL_VERSION}/${tarball}"; \
      echo "${NODE_MUSL_TARBALL_SHA256}  /tmp/${tarball}" | sha256sum -c -; \
      tar -xJf "/tmp/${tarball}" -C /tmp --strip-components=2 "${tarball%.tar.xz}/bin/node"; \
      sudo install -m 0755 /tmp/node /usr/bin/node; \
      rm -f "/tmp/${tarball}" /tmp/node; \
      node -p 'process.version + " shared_openssl=" + process.config.variables.node_shared_openssl'; \
    fi

# npm -g, not pnpm -g: Playwright captures a stack trace on every API call
# and regex-parses each frame, so the client pays per character of the
# playwright-core path. pnpm's global store path is ~150 chars, npm's
# /usr/local/lib/node_modules one ~80, as official's /usr/lib. Local
# 500x page.evaluate, node CPU ms: pnpm 164-175, npm 161-167, official
# 154-162. global-node-path.sh already resolves `npm root -g`.
RUN sudo npm install -g --no-fund --no-audit playwright@${PLAYWRIGHT_VERSION} \
    && sudo share-dir-with-runner-group "${PNPM_HOME}"

COPY --from=browsers-staged /ms-playwright/chromium_headless_shell-${CHS_REV} /ms-playwright/chromium_headless_shell-${CHS_REV}
# Firefox first: webkit's ICU libs are relative symlinks into the firefox tree,
# so its target must already be in place when the webkit layer lands.
COPY --from=browsers-staged /ms-playwright/firefox-${FF_REV} /ms-playwright/firefox-${FF_REV}
COPY --from=browsers-staged /ms-playwright/webkit-${WK_REV} /ms-playwright/webkit-${WK_REV}
