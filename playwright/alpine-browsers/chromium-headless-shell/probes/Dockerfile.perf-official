# The control arm — Playwright's official glibc image — plus a perf it can run.
#
# noble has no `perf` package. linux-tools-generic drops the binary under a
# kernel-versioned directory, and /usr/bin/perf is a wrapper that refuses to run
# when the booted kernel differs from the package's. Link the real binary and
# call that: the version skew costs warnings, not samples.
ARG BASE
FROM ${BASE}
# libc6-dbg: Ubuntu's libc.so.6 is stripped, so without it every glibc sample
# is a bare address (`libc.so.6 [.] 0x1a1bfa`, run 34504703616) and the memset
# callers pass has nothing to filter on. perf finds the .debug file by build-id
# under /usr/lib/debug, no flag needed; verified in this image, where the same
# memset loop reads `__memset_avx2_unaligned_erms` with it and an address
# without.
# gcc + libc6-dev: the memset-count arm compiles its shim and gate inside the
# container, on both sides, so the control's histogram comes from the same
# source as ours.
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends linux-tools-generic libc6-dbg \
      gcc libc6-dev \
 && ln -sf "$(ls -d /usr/lib/linux-tools-*/perf | head -1)" \
      /usr/local/bin/perf-real \
 && rm -rf /var/lib/apt/lists/*
