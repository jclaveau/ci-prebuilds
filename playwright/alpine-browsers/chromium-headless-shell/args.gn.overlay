# GN args for the musl chrome-headless-shell build.
#
# Strategy: minimal headless build. We don't need full chromium features —
# only the bits PW SDK drives via CDP through headless_shell.
#
# Sourced into args.gn by apply-and-build.sh after aports' args (if any) are
# applied. This file's lines OVERRIDE earlier ones.

# Release build, no debuginfo (keeps the binary lean and the link step under
# the hosted runner's memory budget).
is_debug = false
symbol_level = 0
# aports' community/chromium builds musl chromium with is_official_build=true and
# disables the expensive/unsupported sub-features one by one (chrome_pgo_phase=0,
# use_thin_lto=false, is_cfi=false — all mirrored below). So "official" here buys
# the optimization level WITHOUT the PGO/LTO build cost, on a config Alpine ships.
#
# Measured A/B against the otherwise-identical false build (both with DCHECKs
# already off), run 31793358409, both artifacts probed on one runner:
#
#   screenshot 0.75x | layout 0.93x | everything else inside sample spread
#   artifact 101.8 -> 85.8 MiB compressed (-16.0 MiB, -15.7%)
#   build +1h08 (the whole cost lands in the last ninja round)
#
# We pay that hour so consumers don't: time-to-tests for a prebuilt image is
# ~entirely image pull, and the browser runs in every consumer's CI. The trade
# only makes sense in that direction.
#
# WHEN ITERATING ON THIS BUILD, flipping it back to false is worth it: it cuts
# roughly an hour off each round-trip, and none of the plumbing questions
# (patches applying, ninja converging, smoke, conformance) depend on the
# optimization level. Flip it back before the build you intend to publish, and
# keep dcheck_always_on = false below either way — that one is not tied to this.
is_official_build = true

# Chromium's own default is
# `dcheck_always_on = (build_with_chromium && !is_official_build) || dcheck_is_configurable`
# (build/config/dcheck_always_on.gni), so an is_official_build=false build
# silently turns DCHECKs ON in a release build — which is why this stays pinned
# explicitly rather than riding the default. Measured cost against the official glibc
# headless-shell: layout 9.3x, DOM churn 7.2x, JS heap 2.9x, int JIT loop 1.9x —
# Blink's layout/DOM paths are DCHECK-dense. It also made `DPCHECK(setpriority)`
# fatal, which is why headed conformance needed --cap-add SYS_NICE. Turning it
# off costs nothing at build time (it removes code) and shrinks the binary
# (305 MB -> ~185 MB, the official build's size).
dcheck_always_on = false

# sccache compiler wrapper. Mirrors aports' cc_wrapper=ccache strategy.
# SCCACHE_GHA_ENABLED env (set in the Dockerfile RUN) picks the GitHub Actions
# Cache backend so warm-cache rebuilds finish in ~30min instead of cold ~7h.
cc_wrapper = "sccache"

# musl libc — without this Chromium picks a glibc-only codepath and the build
# fails at link with undefined refs against glibc-specific symbols (e.g.
# __libc_dlopen_mode). aports' chromium APKBUILD sets the same flag.
is_musl = true

# System clang via Chromium's unbundle toolchain — the bundled chromium clang
# doesn't link against musl. clang_base_path is provided at build time by the
# alpine apk install at /usr/lib/llvmNN (the version is picked up from
# `_llvmver` in aports' APKBUILD; the apply-and-build.sh script injects it).
is_clang = true
clang_use_chrome_plugins = false
custom_toolchain = "//build/toolchain/linux/unbundle:default"
host_toolchain = "//build/toolchain/linux/unbundle:default"

# Rust — Chromium 148+ requires Rust support enabled. The triple
# `x86_64-alpine-linux-musl` isn't in Chromium's known-target-triples.txt
# upstream; apply-and-build.sh appends it before gn gen.
enable_rust = true

# Where Chromium finds the Rust toolchain. Upstream defaults to
# //third_party/rust-toolchain which depot_tools fetches; we don't run
# depot_tools, so point at system rust (/usr) installed via the apk
# `rust` + `rust-bindgen` packages. copium's cr148-rust-toolchain-var.patch
# replaces hardcoded //third_party/rust-toolchain refs with $rust_sysroot
# so this var takes effect.
rust_sysroot_absolute = "/usr"
rust_bindgen_root = "/usr"
rustc_version = "yes"

# Headless-only target. Disables a lot of UI / browser-frontend code we never
# use in chrome-headless-shell. We DON'T set headless_use_embedded_resources
# because it conflicts with the default headless_enable_commands. Aports' build
# ships external .pak resources too — apply-and-build.sh stages them next to
# the binary.
is_component_build = false

# Use system libs where Alpine has reasonable versions (matches aports' build).
use_sysroot = false
use_custom_libcxx = true   # aports keeps Chromium's bundled libc++ to avoid alpine's libstdc++ ABI mismatch
use_lld = true

# Disable bundled NaCl / sandbox bits aports patches handle differently.
enable_nacl = false

# Don't treat warnings as errors — Chromium's musl build trips on a few
# clang warnings aports usually suppresses.
treat_warnings_as_errors = false

# Skip features chrome-headless-shell doesn't need. Each line corresponds to
# an apk dep we deliberately don't install — and Chromium's GN config will
# pkg-config-check for it unless disabled here.
# rtc_use_pipewire stays off (WebRTC screen capture over pipewire is not
# something PW drives), but pipewire-dev IS installed now: since chromium 151
# //ui/display pulls //remoting/host/linux:x11_display_utils whenever
# `is_linux && ozone_platform_x11 && enable_remoting`, and that target's
# pkg_config("pipewire_config") makes `gn gen` shell out to pkg-config for
# libpipewire-0.3 (run 32227622665). The config sets ignore_libs = true — the
# library is dlopen'd at runtime — so we only ever need the .pc file present,
# not a link dependency. enable_remoting = false would also cut the edge, but
# the note further down records that it starts an assert chain.
rtc_use_pipewire = false
use_pulseaudio = false         # pulseaudio-dev not installed
use_alsa = false               # alsa-lib-dev installed (harmless)
proprietary_codecs = false
ffmpeg_branding = "Chromium"

# Printing stays ENABLED, cups does not. cups-dev is intentionally not installed
# and PW needs no print/preview to drive CDP, but printing cannot be cut from the
# graph: since chromium 151, //chrome/test/BUILD.gn depends on
# //chrome/browser/ui/webui/print_preview:interactive_ui_tests unconditionally,
# and that file opens with `assert(enable_print_preview)` — so `gn gen` itself
# fails (run 32114910664, 10 min in). gn evaluates the whole gn_all graph, so it
# is not enough that headless_shell never links any of it.
#
# use_cups is the knob that actually keeps cups out: it is what stops
# //printing/BUILD.gn calling cups_config_helper.py at gn-gen time, and
# print-to-PDF needs no CUPS backend. Same combination the headed overlay has
# carried since run 29946711140 (where cutting printing passed gn gen and then
# failed the final link 5 days in). aports sets neither flag, i.e. upstream
# default = enabled.
use_cups = false
enable_basic_printing = true
enable_print_preview = true

# Disable check_version.js for Node.js — Chromium pins v24.12.0; Alpine ships
# v24.16.0. cr138-node-version-check.patch (copium) makes the check gateable
# via this GN arg.
node_version_check = false

# SwiftShader (software Vulkan) links libvk_swiftshader.so which needs
# libffi_pic.a — Chromium expects to find it in third_party/libffi when
# use_system_libffi=false, but it's not shipped. Alpine has libffi-dev (system).
# Aports sets use_system_libffi=true gated on is_official_build=true; setting
# it standalone here. v12 (run 28366063015) failed at SOLINK libvk_swiftshader.so
# with `ld.lld: error: unable to find library -lffi_pic`.
use_system_libffi = true

# Aggressive feature cuts to fit chrome-headless-shell build under GHA's 6h
# hosted-runner cap. v9-v15 all hit the cap mid-compile (37k uncached compiles
# in v15 round-1 → ~35% in 5h). cache-to=registry only commits when buildx
# build exits normally, so cap-cancelled iters never publish their layers →
# each iter starts cold. Cutting headless-shell-irrelevant features below
# (WebRTC, WebGPU/Dawn, ML/XNNPACK) trims the compile graph.
# Drops biggest compile-count subdirs by [obj/third_party/X] grep on v15 logs:
#   xnnpack=1093  webrtc=875  dawn=720  angle=467  vulkan-vl=231  swiftshader=185
#
# WebGL requires Vulkan-backed rendering — v29 shipped without it and
# chromium reported "Initialization of all (0) EGL display types failed" at
# runtime, breaking capabilities.spec.ts::should support webgl(2). Left
# skia_use_vulkan / angle_enable_vulkan at their DEFAULT true so SwiftShader
# has a Vulkan target to render on. Adds ~416 compiles (vulkan-vl + swiftshader)
# = ~5-8 min once sccache is warm; single-digit MB image bloat.
enable_webrtc = false
skia_use_dawn = false
use_dawn = false

# More aports-aligned defaults that headless_shell doesn't conflict with:
# EXPERIMENT (perf/chromium-pgo-thinlto-1.62), knob 1 of 2: chromium's own default for our config
# (is_official_build && !dcheck_always_on && is_linux) is ALREADY 2 -- see
# build/config/compiler/pgo/pgo.gni -- so this line is what keeps PGO off, not
# an absence of support. The profile is a plain public download; apply-and-build
# fetches it and injects pgo_data_path, which is the branch gn takes when the
# path is non-empty (no depot_tools, no gsutil).
chrome_pgo_phase = 2
enable_vr = false                          # no VR/XR
disable_fieldtrial_testing_config = true   # skip field-trial test configs
enable_nocompile_tests = false             # no nocompile testing
is_cfi = false                             # CFI off (no IFUNC support on alpine clang)
# EXPERIMENT (perf/chromium-pgo-thinlto-1.62), knob 2 of 2. Measured
# separately against PW official each knob closed about a third of the
# gap -- baseline 1.42 geomean, PGO 1.28, ThinLTO 1.31 -- and neither
# reached parity. They have never been built together, which is also the
# only configuration that matches what official actually ships. If the
# effects are independent this lands near 1.2 and the remaining ~20% is
# something else; if it lands near 1.0 the two were addressing the same
# missed optimizations from different directions.
#
# is_official_build would default this ON; aports turns it off. Both
# arms cost about +10% build time on their own.
use_thin_lto = true
fatal_linker_warnings = false              # match aports — alpine's lld trips a few warnings
safe_browsing_use_unrar = false            # no unrar (we don't ship)

# Note: tried enable_extensions=false / enable_pdf=false / enable_remoting=false
# here. They trigger downstream assert failures (e.g. //chrome/browser/background/
# extensions/BUILD.gn asserts enable_extensions_core regardless of whether the
# chrome target is even in our build graph). The headless_shell target isn't
# affected by these flags' default values at runtime, so keep them at default
# rather than chase the assert chain. If we ever need to shrink the build
# graph further, the right move is target-level pruning, not feature flags.
